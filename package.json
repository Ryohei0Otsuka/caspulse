{
  "name": "caspulse",
  "version": "0.1.3",
  "private": true,
  "description": "A playful local TwitCasting stream companion that follows broadcaster IDs, logs comments, and visualizes the live vibe.",
  "author": "Ryohei0Otsuka",
  "license": "MIT",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:compile\" \"npm:dev:electron:run\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron:compile": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:run": "wait-on tcp:5173 file:dist-electron/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main/main.js",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "predev": "node scripts/generate-oauth-config.mjs",
    "prebuild": "node scripts/generate-oauth-config.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.2",
    "vite": "8.2.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "io.github.ryohei0otsuka.caspulse",
    "productName": "CASPULSE",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "CASPULSE-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "CASPULSE-Portable-${version}-${arch}.${ext}"
    }
  }
}
